{
    "type": "module",
    "name": "@mario_florio/json-database",
    "version": "1.0.1",
    "description": "A lightweight JSON file–based database wrapper providing a simple ODM-like interface for Node.js projects.",
    "main": "main.js",
    "files": [
        "src/",
        "README.md"
    ],
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:unit": "jest --testPathPatterns=__tests__/unit",
        "test:unit:doc": "jest --testPathPatterns=__tests__/unit/entities/Document.test.js",
        "test:unit:schema": "jest --testPathPatterns=__tests__/unit/entities/Schema.test.js",
        "test:unit:usecases": "jest --testPathPatterns=__tests__/unit/usecases",
        "test:unit:usecases:find": "jest --testPathPatterns=__tests__/unit/usecases/FindDocuments.test.js",
        "test:unit:usecases:findOne": "jest --testPathPatterns=__tests__/unit/usecases/FindOneDocument.test.js",
        "test:unit:usecases:save": "jest --testPathPatterns=__tests__/unit/usecases/SaveDocument.test.js",
        "test:unit:usecases:update": "jest --testPathPatterns=__tests__/unit/usecases/UpdateDocument.test.js",
        "test:unit:usecases:base": "jest --testPathPatterns=__tests__/unit/usecases/UseCase.test.js",
        "test:integration": "jest --testPathPatterns=__tests__/integration",
        "test:integration:docrepo": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB",
        "test:integration:docrepo:instantiate": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB/instantiate.test.js",
        "test:integration:docrepo:create": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB/create.test.js",
        "test:integration:docrepo:read": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB/read.test.js",
        "test:integration:docrepo:update": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB/update.test.js",
        "test:integration:docrepo:delete": "jest --testPathPatterns=__tests__/integration/DocumentRepository.DB/delete.test.js",
        "test:e2e:all": "jest --testPathPatterns=__tests__/e2e*",
        "test:e2e": "jest --testPathPatterns=__tests__/e2e/",
        "test:e2e:instantiate": "jest --testPathPatterns=__tests__/e2e/instantiate.test.js",
        "test:e2e:create": "jest --testPathPatterns=__tests__/e2e/create.test.js",
        "test:e2e:get": "jest --testPathPatterns=__tests__/e2e/get.test.js",
        "test:e2e:getOne": "jest --testPathPatterns=__tests__/e2e/getOne.test.js",
        "test:e2e:update": "jest --testPathPatterns=__tests__/e2e/update.test.js",
        "test:e2e:delete": "jest --testPathPatterns=__tests__/e2e/delete.test.js",
        "test:e2e.odm": "jest --testPathPatterns=__tests__/e2e.odm",
        "test:e2e.odm:find": "jest --testPathPatterns=__tests__/e2e.odm/find.test.js",
        "test:e2e.odm:findOne": "jest --testPathPatterns=__tests__/e2e.odm/findOne.test.js",
        "test:e2e.odm:findById": "jest --testPathPatterns=__tests__/e2e.odm/findById.test.js",
        "test:e2e.odm:findOneAndDelete": "jest --testPathPatterns=__tests__/e2e.odm/findOneAndDelete.test.js",
        "test:e2e.odm:findOneAndUpdate": "jest --testPathPatterns=__tests__/e2e.odm/findOneAndUpdate.test.js",
        "test:e2e.odm:findByIdAndDelete": "jest --testPathPatterns=__tests__/e2e.odm/findByIdAndDelete.test.js",
        "test:e2e.odm:findByIdAndUpdate": "jest --testPathPatterns=__tests__/e2e.odm/findByIdAndUpdate.test.js",
        "test:e2e.odm:virtuals": "jest --testPathPatterns=__tests__/e2e.odm/virtuals.test.js",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format:write": "prettier --write \"**/*.js\"",
        "format:check": "prettier --check \"**/*.js\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "babel-jest": "^30.1.2",
        "eslint": "^9.35.0",
        "jest": "^30.1.3",
        "prettier": "^3.6.2"
    }
}
